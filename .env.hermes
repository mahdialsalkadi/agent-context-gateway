# ==============================================================================
# PROFILE: Hermes Agent
#
#   python -m src.gateway --profile hermes
#
# Wire this in ADDITIVELY: keep the provider block that already works in
# ~/.hermes/config.yaml and add this gateway as an additional provider, rather
# than repointing the active `model.base_url`. See configs/hermes.md.
# ==============================================================================

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8091

UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
UPSTREAM_API_KEY=REPLACE_ME

# Classify on the same subscription the agent uses, so no extra key is needed.
# The key below is borrowed from UPSTREAM_API_KEY, never duplicated.
CLASSIFIER_MODE=upstream_reused
CLASSIFIER_MODEL=google/gemini-2.5-flash-lite
# CLASSIFIER_API_KEY_ENV=UPSTREAM_API_KEY

# --- Graph memory -------------------------------------------------------------
# Recalled facts are injected into later prompts. The SQLite graph lives in
# DATA_DIR and is shared across every profile, so switching profiles keeps it.
MEMORY_INJECTION=1
