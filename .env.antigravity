# ==============================================================================
# PROFILE: Google Antigravity bridge (Google One / Gemini subscription)
#
#   python -m src.gateway --profile antigravity
#
# Zero extra cost. Classification runs on the SAME subscription the agent
# already uses, and tool-schema pruning typically removes 70-90% of the input
# tokens a turn would otherwise spend -- which is what keeps a Google One /
# Gemini daily quota from running out mid-session.
# ==============================================================================

# --- Port layout: these two must not overlap --------------------------------
#   Antigravity bridge : 8080
#   this gateway       : 8091
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8091

# --- Upstream: the local Antigravity server ---------------------------------
UPSTREAM_BASE_URL=http://127.0.0.1:8080/v1
UPSTREAM_API_KEY=REPLACE_ME_ONLY_IF_YOUR_BRIDGE_NEEDS_ONE

# 8080 is normally treated as "probably another proxy" by the loop guard. In
# this profile it IS the upstream, so relax that heuristic. The real guard --
# refusing to forward to this gateway's own address -- still applies.
ALLOW_LEGACY_UPSTREAM_PORT=1

# --- Classifier: reuse the subscription, no second provider ------------------
# `heuristics` is also valid here for a literal zero-token, zero-latency mode.
# CLASSIFIER_MODE=heuristics
CLASSIFIER_MODE=upstream_reused
CLASSIFIER_MODEL=gemini-2.5-flash

# --- Storage (shared by every profile, so switching never loses state) -------
# DATA_DIR=~/.agent-gateway/data
# LOG_DIR=~/.agent-gateway/logs
