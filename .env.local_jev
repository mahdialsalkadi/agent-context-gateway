# ==============================================================================
# agent-context-gateway -- local Jev decision-classifier profile
#
#   llama-server -m Jev-Q4_K_M.gguf --port 11435 -ngl 99 -c 2048 --threads 4
#   agent-gateway start --profile local_jev
#
# -ngl 99 offloads every layer to the GPU via Vulkan. Confirm the build sees a
# device with:  llama-server --list-devices
# and that startup logs "offloaded 26/26 layers to GPU".
#
# Routing verdicts are produced entirely on this machine by a 2B GGUF: one
# forward pass, one letter (A/B) read straight from the log probabilities.
# No key, no network, no spend.
# ==============================================================================

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8091

# The model your agent actually talks to. Replace with any OpenAI-compatible
# endpoint; this example points at a local llama.cpp server.
UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1

# --- Local Jev GGUF classifier ------------------------------------------------
CLASSIFIER_MODE=local_jev
LOCAL_JEV_URL=http://127.0.0.1:11435/v1/chat/completions
CLASSIFIER_MODEL=jev-style-qwen3.5-2b
# Verdict budget in seconds. 0.4 is comfortable with GPU offload; raise it
# (e.g. 2.0) on a CPU-only host so verdicts are not lost to the timeout.
LOCAL_JEV_TIMEOUT_SECONDS=0.4
CLASSIFIER_NEEDS_TOOLS_THRESHOLD=0.15

# --- Selective sub-tool pruning ----------------------------------------------
ENABLE_SELECTIVE_PRUNING=1
SELECTIVE_TOOL_LIMIT=5
