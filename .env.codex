# ==============================================================================
# PROFILE: Codex / GitHub Copilot bridge
#
#   python -m src.gateway --profile codex
#
# Typical local bridge: copilot-gpt4-service. 4141 is not a reserved proxy port,
# so nothing needs relaxing here.
# ==============================================================================

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8091

UPSTREAM_BASE_URL=http://127.0.0.1:4141/v1
UPSTREAM_API_KEY=REPLACE_ME_ONLY_IF_YOUR_BRIDGE_NEEDS_ONE

# --- Classifier ---------------------------------------------------------------
# `heuristics` costs nothing at all. Flip to `upstream_reused` to get judgement
# calls on the Copilot subscription instead of the local rules -- still free,
# but it spends a few tokens per ambiguous turn.
CLASSIFIER_MODE=heuristics
# CLASSIFIER_MODE=upstream_reused
# CLASSIFIER_MODEL=gpt-4o-mini
