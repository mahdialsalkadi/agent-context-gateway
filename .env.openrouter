# ==============================================================================
# PROFILE: OpenRouter direct (commercial credits)
#
#   python -m src.gateway --profile openrouter
#
# The paid path: routing and classification both go to OpenRouter. Kept as a
# first-class profile so a zero-cost setup is a choice, never a constraint.
# ==============================================================================

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090

UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
UPSTREAM_API_KEY=REPLACE_ME

# --- Classifier: reuse the upstream key (no second credential) ---------------
CLASSIFIER_MODE=upstream_reused
CLASSIFIER_MODEL=google/gemini-2.5-flash-lite

# To bill classification to a different account, use the dedicated mode instead:
# CLASSIFIER_MODE=external_jev
# CLASSIFIER_API_URL=https://openrouter.ai/api/v1/chat/completions
# CLASSIFIER_API_KEY=
# CLASSIFIER_API_KEY_ENV=OPENROUTER_API_KEY

# --- Optional: protect the port ----------------------------------------------
# GATEWAY_API_KEY=
