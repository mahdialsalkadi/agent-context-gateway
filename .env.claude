# ==============================================================================
# PROFILE: Claude Code (Anthropic /v1/messages)
#
#   python -m src.gateway --profile claude
#   export ANTHROPIC_BASE_URL="http://127.0.0.1:8091"
#
# Claude Code speaks the Anthropic Messages API, not chat completions. The
# gateway accepts /v1/messages on this port and translates it to whichever
# OpenAI-compatible upstream you point at, so the pruning, spillover and memory
# pipeline applies to Claude Code unchanged.
# ==============================================================================

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8091

# Any OpenAI-compatible endpoint that can serve Claude's turns. Point this at a
# local bridge (see .env.antigravity) to stay on a subscription, or at a direct
# API for commercial routing.
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
UPSTREAM_API_KEY=REPLACE_ME

# --- Claude Code authentication ---------------------------------------------
# The gateway never forwards your client credential upstream; it injects the
# upstream key itself. Set GATEWAY_API_KEY only if you also want to require a
# bearer token from Claude Code:
# GATEWAY_API_KEY=

# --- Model ids ----------------------------------------------------------------
# Claude Code requests `claude-*` ids. Set this only when your upstream does not
# serve those names, otherwise the requested id is forwarded as-is:
# ANTHROPIC_MODEL_OVERRIDE=anthropic/claude-sonnet-4

# --- Classifier ---------------------------------------------------------------
CLASSIFIER_MODE=heuristics

# --- Thinking blocks ----------------------------------------------------------
# Reasoning text is NOT re-emitted as Anthropic `thinking` blocks by default.
# The upstream cannot supply a verifiable signature, and strict Anthropic
# clients reject an unsigned thinking block -- emitting one would break the
# stream it is trying to enrich. Bash/file tool output pruning is unaffected and
# always on. Opt in only if your client tolerates unsigned blocks:
# ANTHROPIC_THINKING_PASSTHROUGH=1
