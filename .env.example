# ==============================================================================
# agent-context-gateway -- configuration template
#
#   cp .env.example .env      then fill in the values below.
#
# .env is gitignored. Never commit real credentials.
# Every value here can also be supplied as a plain environment variable, which
# takes precedence over the .env file.
# ==============================================================================

# --- Listen address -----------------------------------------------------------
# Bind to 127.0.0.1 for local agents. Use 0.0.0.0 only inside a container or
# behind a firewall, and set GATEWAY_API_KEY so the proxy is not open.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090

# --- Storage -----------------------------------------------------------------
# SQLite graph database lives in DATA_DIR; JSON audit log lives in LOG_DIR.
DATA_DIR=~/.agent-gateway/data
LOG_DIR=~/.agent-gateway/logs
# Oversized tool output is spilled here. /dev/shm is a RAM disk on Linux; the
# gateway falls back to /tmp/agent_gateway automatically when it is absent.
# SHM_CACHE_DIR=/dev/shm/agent_gateway

# --- Upstream provider (REQUIRED) -------------------------------------------
# Any OpenAI-compatible endpoint. Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://127.0.0.1:11434/v1          (Ollama)
#   http://127.0.0.1:8000/v1           (vLLM / llama.cpp server)
#
# The gateway REFUSES to start if this resolves to its own listen address,
# because that would create an infinite forwarding loop.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-REPLACE_ME
# Fallback names if UPSTREAM_API_KEY is unset: OPENAI_API_KEY, OPENROUTER_API_KEY
# UPSTREAM_TIMEOUT_SECONDS=180
#
# Ports 8080 and 8090 are refused as upstreams by default, on the guess that
# another proxy lives there. A local subscription bridge (Antigravity, Copilot)
# genuinely does, so claim the port explicitly:
# ALLOW_LEGACY_UPSTREAM_PORT=1

# --- Optional: Anthropic surface (Claude Code) ------------------------------
# Claude Code requests `claude-*` model ids. Set this if your upstream does not
# serve those names (e.g. a plain OpenAI or vLLM endpoint).
# ANTHROPIC_MODEL_OVERRIDE=gpt-4o-mini
#
# Reasoning text is dropped by default rather than re-emitted as an Anthropic
# `thinking` block: the signature cannot be verified against an OpenAI-shaped
# upstream, and strict clients reject an unsigned block. Opt in only if your
# client tolerates that.
# ANTHROPIC_THINKING_PASSTHROUGH=1

# --- Optional: protect this gateway -----------------------------------------
# When set, clients must send `Authorization: Bearer <value>`. The gateway
# strips its own credential and injects the upstream one.
# GATEWAY_API_KEY=

# --- Classifier mode ----------------------------------------------------------
# Where a routing verdict comes from. The fast local heuristics always run first
# and every mode fails OPEN (on timeout, error, missing key or unparseable reply
# the tools are kept). Ambiguous prompts are the only ones that need a decision.
#
#   heuristics       no network call at all. Zero cost, zero latency. Unresolved
#                    turns simply keep their tools. (default when nothing is set)
#   upstream_reused  classify on the subscription you already pay for, using the
#                    upstream's own URL and key. No second provider, no second bill.
#   local_ollama     a model on this machine -- nothing leaves the host.
#   local_jev        the Jev-Style Qwen3.5-2B GGUF on llama-server: one forward
#                    pass, one letter read from logprobs, ~15ms, offline.
#   external_jev     a dedicated endpoint (OpenRouter/OpenCode/AI gateway), where
#                    the `blueprint` protocol is also available.
#
# Unset (or `auto`) keeps the original behaviour: a configured URL + key means
# external_jev, otherwise heuristics.
# CLASSIFIER_MODE=heuristics

# --- Optional: classifier endpoint (needed by `external_jev`) -----------------
# CLASSIFIER_API_URL=https://api.openai.com/v1/chat/completions
# CLASSIFIER_MODEL=gpt-4o-mini
# CLASSIFIER_API_KEY_ENV=UPSTREAM_API_KEY    # borrow a key instead of duplicating
# CLASSIFIER_API_KEY=
# CLASSIFIER_PROTOCOL=openai                 # `openai` or `blueprint`
# CLASSIFIER_TIMEOUT_SECONDS=2.5
# CLASSIFIER_NEEDS_TOOLS_THRESHOLD=0.15
# CLASSIFIER_SUPERSEDE_THRESHOLD=0.75

# --- Optional: local runner (needed by `local_ollama`) ------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# CLASSIFIER_MODEL=qwen2.5:0.5b

# --- Optional: local Jev decision GGUF (needed by `local_jev`) -----------------
# Serve it with every layer on the GPU via Vulkan (-ngl 99):
#   llama-server -hf chaoliangUNSW/Jev-Style-Qwen3.5-2B-Decision-GGUF:Q4_K_M \
#     --port 11435 -ngl 99 -c 2048 --threads 4
# Check for a device first:  llama-server --list-devices
# Missing drivers (Debian/Ubuntu): sudo apt install vulkan-tools mesa-vulkan-drivers
# LOCAL_JEV_URL=http://127.0.0.1:11435/v1/chat/completions
# CLASSIFIER_MODEL=jev-style-qwen3.5-2b
# LOCAL_JEV_TIMEOUT_SECONDS=0.4        # raise to ~2.0 on CPU-only hosts

# --- Optional: behaviour tuning ----------------------------------------------
# MEMORY_INJECTION=1                # inject recalled graph triples into prompts
# MEMORY_INJECT_TOOL_TURNS=0        # also inject during tool loops
# TRUNCATE_THRESHOLD_CHARS=800      # spill historical tool output above this
# SNIFF_LIMIT_BYTES=512             # bounded escape-token look-ahead window
# ESCAPE_SCAN_CHARS=64              # give up sniffing this early
# REASONING_MODEL_REGEX=            # extra regex, comma separated

# --- Selective sub-tool pruning ------------------------------------------------
# With a large schema, keep only the tools the prompt implies (BM25 over tool
# names and descriptions, plus a multilingual intent map for prompts BM25 cannot
# read, purely local, < 2ms). This is an absolute cap: the whole catalog is never
# forwarded, mid-tool-loop turns included, and an explicit tool_choice disables
# ranking entirely. The core set (bash / read_file / edit_file / write_file /
# fetch_log) always survives.
# ENABLE_SELECTIVE_PRUNING=1        # 0 to disable
# SELECTIVE_TOOL_LIMIT=5            # hard ceiling on tools per turn
